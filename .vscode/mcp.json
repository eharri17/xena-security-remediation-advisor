{
  // Dedicated, least-privilege MCP servers for the Security Remediation Advisor PoC.
  // The Copilot harness does not support ${input:...} variables, so tokens come from
  // environment variables (JIRA_PAT, BITBUCKET_PAT) and are never stored in git.
  // Base URLs are not secret and are pinned below.
  "servers": {
    "advisor-atlassian": {
      "type": "http",
      "url": "https://atlassian-mcp.xena.dev/mcp/",
      "headers": {
        "X-Atlassian-Jira-Url": "https://jira.jnj.com",
        "X-Atlassian-Jira-Personal-Token": "${env:JIRA_PAT}",
        "X-Atlassian-Bitbucket-Url": "https://sourcecode.jnj.com",
        "X-Atlassian-Bitbucket-Personal-Token": "${env:BITBUCKET_PAT}",
        // Server-side enforcement: write tools are disabled for every product.
        "X-Atlassian-Read-Only-Mode": "true",
        "X-Atlassian-Enable-Xray": "false"
      }
    },
    "advisor-wiz": {
      "type": "http",
      "url": "https://mcp.app.wiz.io",
      "headers": {
        "Wiz-DataCenter": "us62"
      }
    }
  }
}
